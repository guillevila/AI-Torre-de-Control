# Variables de entorno — NUNCA subir a GitHub
.env
.env.local
.env.development
.env.production
.env.*
!.env.example

# Dependencias — se reinstalan con el comando de instalación
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Builds — se generan con el comando de build
dist/
build/
.next/
out/

# Resultados de las pruebas de interfaz
test-results/
playwright-report/
blob-report/
.playwright/

# Bases de datos locales — los datos reales viven en la carpeta del usuario,
# nunca en el repositorio
*.db
*.db-journal
*.sqlite
*.sqlite3

# Fichero de conexión del receptor local (contiene la clave local)
event-endpoint.json

# Logs de auditoría local (opcionales — quitar si quieres subirlos)
.claude/audit/

# Ajustes personales de Claude Code — cada persona tiene los suyos, no se comparten
.claude/settings.local.json

# Interruptor del modo ininterrumpido — es una decisión personal de cada sesión,
# nunca se hereda al clonar el repositorio
.claude/modo-ininterrumpido.on

# IDEs y editores
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Archivos temporales
*.tmp
*.temp
*.log

# Claves y certificados
*.pem
*.key
*.cert
*.p12
