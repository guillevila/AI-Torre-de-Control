{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Read(.env*)",
      "Read(**/*.env)",
      "Read(**/secrets/**)",
      "Read(**/*secret*)",
      "Read(**/*password*)",
      "Read(**/*credential*)",
      "Edit(.env*)",
      "Edit(**/*.env)",
      "Edit(**/secrets/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf /*)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git push origin*)",
      "Bash(pnpm install)",
      "Bash(pnpm test*)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm dev)",
      "Bash(pnpm evento*)"
    ]
  },
  "includeGitInstructions": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": [".claude/hooks/session-start.mjs"] }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "node", "args": [".claude/hooks/pre-tool-use.mjs"] }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "node", "args": [".claude/hooks/post-tool-use.mjs"] }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "node", "args": [".claude/hooks/stop.mjs"] }]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          { "type": "command", "command": "node", "args": [".claude/hooks/log-subagent-spawn.mjs"] }
        ]
      }
    ]
  }
}
