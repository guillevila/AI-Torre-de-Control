{
  "name": "@torre/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación de escritorio de AI Torre de Control",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/launch.mjs dev",
